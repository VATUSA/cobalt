  auth: inherit
}

params:path {
  id: 1
}

body:json {
  {
    "policy_category_id": 1,
    "ident": "TEST-1",
    "title": "Updated Document",
    "summary": "An updated document.",
    "document_url": "https://www.vatusa.net/files/test.pdf",
    "effective_date": "2026-01-01",
    "hidden": false,
    "sort_order": 0
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
