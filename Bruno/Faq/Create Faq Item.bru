meta {
  name: Create Faq Item
  type: http
  seq: 5
}

post {
  url: {{hostname}}/faq/item
  body: json
  auth: inherit
}

body:json {
  {
    "faq_category_id": 1,
    "question": "Is this a test question?",
    "answer": "Yes.",
    "sort_order": 0
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
